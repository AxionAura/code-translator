{
  "name": "code-translator",
  "version": "0.0.0",
  "private": true,
  "description": "Behavior-preserving source code translator for Python, JavaScript and TypeScript. Milestone status in PROJECT_STATE.md, plan in docs/roadmap.md.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm docs:check",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "docs:check": "node scripts/check-doc-links.mjs",
    "fixtures:accept": "FIXTURES_ACCEPT=1 vitest run tests/golden-fixtures.test.ts"
  },
  "devDependencies": {
    "@ctrans/codegen-js": "workspace:*",
    "@ctrans/core": "workspace:*",
    "@ctrans/parser-js": "workspace:*",
    "@ctrans/parser-py": "workspace:*",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "@ctrans/registry": "workspace:*"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
