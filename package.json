{
  "name": "code-translator",
  "version": "0.1.1",
  "private": true,
  "description": "Behavior-preserving source code translator for Python, JavaScript and TypeScript. Milestone status in PROJECT_STATE.md, plan in docs/roadmap.md.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "verify": "pnpm build && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm docs:check",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "docs:check": "node scripts/check-doc-links.mjs",
    "fixtures:accept": "FIXTURES_ACCEPT=1 vitest run tests/golden-fixtures.test.ts",
    "build": "pnpm -r --workspace-concurrency=4 build",
    "benchmark": "node apps/cli/bin/ctrans.mjs benchmark",
    "benchmark:mini": "node apps/cli/bin/ctrans.mjs benchmark --suite mini-projects --iterations 1",
    "benchmark:perf": "node apps/cli/bin/ctrans.mjs benchmark --suite perf --iterations 1",
    "perf:smoke": "vitest run tests/perf-smoke.test.ts",
    "benchmark:nightly": "node scripts/benchmark-nightly.mjs"
  },
  "devDependencies": {
    "@astral-sh/ruff-wasm-nodejs": "0.17.1",
    "@axion-ct/codegen-js": "workspace:*",
    "@axion-ct/codegen-py": "workspace:*",
    "@axion-ct/core": "workspace:*",
    "@axion-ct/parser-js": "workspace:*",
    "@axion-ct/parser-py": "workspace:*",
    "@axion-ct/registry": "workspace:*",
    "@axion-ct/sandbox": "workspace:*",
    "@axion-ct/validator": "workspace:*",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "pyright": "1.1.406",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
